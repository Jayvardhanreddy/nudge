PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
ADMIN_EMAIL=your-admin-email@example.com
META_APP_ID=your-instagram-business-login-app-id
META_APP_SECRET=your-instagram-business-login-app-secret
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_API_VERSION=v25.0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=64-character-hex-key
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=nudge

# Security / quotas
JWT_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
AI_MONTHLY_LIMIT_FREE=30
AI_MONTHLY_LIMIT_PRO=150
AI_MONTHLY_LIMIT_ELITE=500
# Password reset email delivery (required to enable reset emails)
RESEND_API_KEY=
RESET_FROM_EMAIL=
PUBLIC_APP_URL=https://nudge-dto0.onrender.com
