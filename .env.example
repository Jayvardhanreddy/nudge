# Copy to .env locally. Never commit .env or place these values in browser code.
PORT=3000
NODE_ENV=development
JWT_SECRET=
ADMIN_EMAIL=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
MONGODB_URI=
MONGODB_DB_NAME=nudge

# Optional email delivery for password resets
RESEND_API_KEY=
RESET_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:3000

# AI usage caps
AI_MONTHLY_LIMIT_FREE=30
AI_MONTHLY_LIMIT_PRO=150
AI_MONTHLY_LIMIT_ELITE=500
